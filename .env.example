# =============================================================================
# barber-saas — environment variables
# Copy to .env and fill in. NEVER commit .env. All secrets stay server-side.
# Validated at boot by src/env.ts (zod) — the app refuses to start if invalid.
# =============================================================================

# ---- Core -------------------------------------------------------------------
NODE_ENV=development
# Public base URL of the app (no trailing slash). Used for links in e-mails, OAuth, webhooks.
APP_URL=http://localhost:3000
# Comma-separated locales; first is the default.
APP_LOCALES=pt-BR,en,es
APP_DEFAULT_LOCALE=pt-BR

# ---- Database (Azure Database for PostgreSQL Flexible Server) ---------------
# Local dev via docker-compose: postgres://barber:barber@localhost:5432/barber
DATABASE_URL=postgres://barber:barber@localhost:5432/barber?schema=public
# Optional dedicated URL for migrations / connection without pgbouncer pooling.
DIRECT_DATABASE_URL=

# ---- Redis (Azure Cache for Redis) — sessions cache, rate limit, job queue --
REDIS_URL=redis://localhost:6379

# ---- Auth / sessions ------------------------------------------------------
# 32+ random bytes, base64. Generate: openssl rand -base64 48
AUTH_SECRET=change-me-generate-a-long-random-value
# Session lifetimes (seconds)
SESSION_TTL_SECONDS=2592000          # 30 days (tenant users)
ADMIN_SESSION_TTL_SECONDS=43200      # 12 hours (super admin — shorter on purpose)

# ---- E-mail (Resend) ------------------------------------------------------
# Leave RESEND_API_KEY empty in dev to route e-mails to the console transport.
RESEND_API_KEY=
EMAIL_FROM="Barber SaaS <no-reply@example.com>"

# ---- Object storage (Azure Blob Storage) --------------------------------
# Leave empty in dev to use the local-disk driver (./.storage).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=uploads
# Public base URL for served blobs (CDN or blob endpoint). Empty => local /uploads route.
STORAGE_PUBLIC_URL=

# ---- Stripe — SaaS subscription billing (platform account) -------------
# Integration is fully wired but INACTIVE until these are set.
# Use TEST keys (sk_test_ / pk_test_) for development; live keys only in prod.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: Stripe-hosted Pricing Table embed id (not required — the app renders
# its own pricing UI from Plan rows).
STRIPE_PRICING_TABLE_ID=
# Stripe Tax on SaaS checkout. Leave empty unless you have configured tax
# registrations in the Stripe Dashboard. Set to "true" to enable automatic_tax +
# billing-address collection on subscription Checkout. See docs/STRIPE.md.
STRIPE_TAX_ENABLED=

# ---- Stripe Connect — barbershops receiving from their own clients ----
# Separate money flow from the SaaS subscription above.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Platform fee charged on each client payment, in basis points (e.g. 200 = 2%).
PLATFORM_FEE_BPS=0
# NOTE: STRIPE_CONNECT_CLIENT_ID is intentionally NOT used — this integration
# uses Express accounts + Account Links, not the Standard OAuth connect flow, so
# no OAuth client id is required. See docs/STRIPE.md.

# ---- WhatsApp Business Platform (Meta Cloud API) — official API only ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---- Chatbot LLM provider (Anthropic by default) ---------------------
# Empty => chatbot endpoints return 503 "not configured".
ANTHROPIC_API_KEY=
CHATBOT_MODEL=claude-sonnet-5

# ---- Observability (optional) ---------------------------------------
SENTRY_DSN=
LOG_LEVEL=info
