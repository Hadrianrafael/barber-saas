# ---------------------------------------------------------------------------
# STAGING — variable NAMES only. NO VALUES in this file, ever.
#
# Copy to `.env.staging` (git-ignored) and fill the values LOCALLY, then push
# them to Key Vault:
#   npm run keyvault:push -- --vault <keyVaultName> --file .env.staging --dry-run
#   npm run keyvault:push -- --vault <keyVaultName> --file .env.staging
#
# <keyVaultName> is the `keyVaultName` output of `az deployment group create`
# (pattern: barber-stg-kv-xxxxxxxx). Do NOT guess it.
#
# database-url / redis-url / azure-storage-connection-string are DERIVED by the
# Bicep from the provisioned Postgres / Redis / Storage — they are NOT set here.
# ---------------------------------------------------------------------------

# --- Required (app will not boot without these) ---
AUTH_SECRET=                       # openssl rand -base64 48   (48+ random bytes)

# --- Stripe (TEST mode for staging — never sk_live_ here) ---
STRIPE_SECRET_KEY=                 # sk_test_...
STRIPE_PUBLISHABLE_KEY=            # pk_test_...  (not secret, still vaulted for parity)
STRIPE_WEBHOOK_SECRET=            # whsec_...  — exists only AFTER you create the platform webhook endpoint
STRIPE_CONNECT_WEBHOOK_SECRET=    # whsec_...  — exists only AFTER you create the Connect webhook endpoint

# --- Resend (transactional e-mail) ---
RESEND_API_KEY=                    # re_...
# EMAIL_FROM is a NON-secret env var set in infra/main.bicep (appEnv) — change it there.

# --- Anthropic (AI chatbot) ---
ANTHROPIC_API_KEY=                 # sk-ant-...

# --- WhatsApp Cloud API (all five required together, or leave all blank) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=     # you choose this string; reuse it in the Meta webhook config
WHATSAPP_APP_SECRET=

# --- Sentry (optional) ---
SENTRY_DSN=
